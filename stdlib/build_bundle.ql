// Build/check the shared standard-library source bundle using QLang itself.
// Run from the repository root; no Python or backend-specific operations.
let slice = (s, start, end) -> {
  let out = ""; let i = start;
  while i < end { out = out + s[i]; i = i + 1; };
  out;
};
let quotedSource = (source) -> {
  let quoted = std.JSON.stringify(source); let out = ""; let i = 0;
  while i < quoted.length {
    if quoted[i] == "$" && i + 1 < quoted.length && quoted[i + 1] == "{" { out = out + "\\"; };
    out = out + quoted[i]; i = i + 1;
  };
  out;
};
let manifest = std.JSON.parse(std.fs.readFileText("stdlib/manifest.json")?)?;
let source = "let __build_standard_library = (std) -> {\n";
let origins = "["; let seen = {}; let lineCount = 1; let m = 0;
while m < manifest.modules.length {
  let name = manifest.modules[m];
  let text = std.fs.readFileText("stdlib/" + name)?;
  // Preserve physical newlines and original Unicode-scalar offsets.
  // Unicode line/paragraph separators inside strings are ordinary data.
  let sourceSize = text.length; let lines = []; let endings = []; let sourceStarts = [0];
  let cursor = 0; let lineText = "";
  while cursor < sourceSize {
    let c = text[cursor];
    if c == "\r" || c == "\n" {
      lines[lines.length] = lineText; lineText = "";
      let ending = c;
      if c == "\r" && cursor + 1 < sourceSize && text[cursor + 1] == "\n" { ending = "\r\n"; cursor = cursor + 1; };
      endings[endings.length] = ending;
      sourceStarts[sourceStarts.length] = cursor + 1;
    } else { lineText = lineText + c; };
    cursor = cursor + 1;
  };
  if sourceStarts[sourceStarts.length - 1] < sourceSize { lines[lines.length] = lineText; endings[endings.length] = "\n"; };
  let count = lines.length;
  let start = lineCount + 1; let i = 0;
  while i < count {
    let line = lines[i];
    if std.String.startsWith(line)("import ") {
      if !std.String.startsWith(line)("import ./") || !std.String.endsWith(line)(";") {
        std.Error.raise("BundleError", "unsupported library import in " + name, null)?;
      };
      let dependency = slice(line, 9, line.length - 1);
      if isError(seen[dependency]) {
        std.Error.raise("BundleError", "library dependency must precede " + name + ": " + dependency, null)?;
      };
      source = source + "// bundled import" + endings[i];
    } else if std.String.startsWith(line)("export ") {
      source = source + "// bundled export" + endings[i];
    } else { source = source + line + endings[i]; };
    lineCount = lineCount + 1; i = i + 1;
  };
  if m > 0 { origins = origins + ", "; };
  origins = origins + "{path: " + std.JSON.stringify("stdlib/" + name) + ", startLine: " + std.Number.toString(start) + ", endLine: " + std.Number.toString(lineCount) + ", sourceLineStarts: " + std.JSON.stringify(sourceStarts) + ", sourceLength: " + std.Number.toString(sourceSize) + "}";
  seen[name] = true; m = m + 1;
};
source = source + "{";
let bindings = manifest.exports; let i = 0;
while i < bindings.length {
  if i > 0 { source = source + ", "; };
  source = source + bindings[i].name + ": " + bindings[i].value; i = i + 1;
};
source = source + "};\n};\n";
let bundle = "// Generated by stdlib/build_bundle.ql; do not edit.\nlet standardLibrarySource = ";
i = 0;
while i < source.length {
  let end = i + 1024; if end > source.length { end = source.length; };
  if i > 0 { bundle = bundle + " + "; };
  bundle = bundle + quotedSource(slice(source, i, end)); i = end;
};
bundle = bundle + ";\nlet standardLibraryOrigins = " + origins + "];\nexport { standardLibrarySource, standardLibraryOrigins };";
if args.length > 0 && args[0] == "--check" {
  let current = std.fs.readFileText("stdlib/bundle.ql")?;
  if current != bundle + "\n" { std.Error.raise("BundleError", "stale library bundle; run stdlib/build_bundle.ql", null)?; };
  println("Standard library source bundle verified");
} else { println(bundle); };
