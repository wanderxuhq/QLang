let checks = 0;
let check = (ok, label) -> { checks = checks + 1; if !ok { println("FAIL " + label); }; };
let a = import ./modules/lazy/a.ql;
check(a.loadB() == "AB", "lazy cycle executes after defining module initialization");
check(a.loadB() == "AB", "repeated lazy cycle gets fresh initialization");
let b = import ./modules/lazy/b.ql;
check(b.value == "AB", "opposite cycle entry also initializes");
let skipped = import ./modules/lazy/skipped.ql;
check(skipped.value == 42, "untaken and uncalled self import does not cycle");
let failed = import ./modules/lazy/fail.ql;
let failedAgain = import ./modules/lazy/fail.ql;
check(failed.type == "DivisionByZero" && failedAgain.type == "DivisionByZero", "normal error clears initialization state");
let propagated = import ./modules/lazy/propagate.ql;
let propagatedAgain = import ./modules/lazy/propagate.ql;
check(propagated.message == "module failed" && propagatedAgain.message == "module failed", "propagation clears initialization state");
let cycle = import ./modules/lazy/cycle.ql;
let cycleAgain = import ./modules/lazy/cycle.ql;
check(cycle.type == "ImportCycle" && cycleAgain.type == "ImportCycle", "executed self cycle remains an error");
let mutual = import ./modules/lazy/mutual_a.ql;
let mutualAgain = import ./modules/lazy/mutual_a.ql;
check(mutual.type == "ImportCycle" && mutualAgain.type == "ImportCycle", "executed mutual cycle remains an error");
let after = import ./modules/lazy/skipped.ql;
check(after.value == 42, "failed imports do not poison other module states");
println("lazy module checks: " + std.String.toString(checks));
