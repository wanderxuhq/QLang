// A declaration establishes a binding, never a null value. Reading it before
// initialization is now a frontend error (see bootstrapped/tests/diagnostics.ql).
let pending = null; let zero = 0;
println(Null.check(pending));
println(std.Type.of(pending) == Null);
pending = 7;
println(pending);
let pending2 = 0;
println(pending2);
pending2 = "ready";
println(pending2);

let nullable: Null = null;
nullable = null;
println(Null.check(nullable));
nullable = 1;
println(nullable.type);
println(nullable.message);
nullable = null;
println(Null.check(nullable));
let initialized: Null = null;
println(Null.check(initialized));
let number: Number = "bad";
println(number.type);
println(number.message);
number = 42;
println(number);
let invalid: 42;
invalid = "no annotation retained";
println(invalid);
let invalidNull: null = 2;
println(invalidNull.type);
invalidNull = 3;
println(invalidNull.type);

let count = 0;
let Positive = std.Type.make((v) -> { count = count + 1; v > 0; });
let positive: Positive;
println(count);
positive = 1;
positive = -1;
println(count);
println(positive.type);
let error = std.Error.raise("Original", "bad", null);
let errorValue: Error = error;
println(errorValue.type);
let mismatch: Number = error;
println(mismatch.type);
println(mismatch.cause.type);
let Broken = std.Type.make((v) -> 1 / zero);
let broken: Broken = 1;
println(broken.type);
let AlwaysFalse = std.Type.make((v) -> []);
let falseValue: AlwaysFalse = 1;
println(falseValue.type);
let values: Array(Number) = [1, 2];
println(values[1]);
values = [1, "bad"];
println(values.type);
let record: Object({a: Number}) = {a: 2};
println(record.a);
record = {};
println(record.type);

// Annotation expression precedes initializer, and is evaluated only once.
let order = "";
let annotation = () -> { order = order + "T"; Number; };
let initializer = () -> { order = order + "V"; 1; };
let ordered: annotation() = initializer();
ordered = 2;
println(order);
let Selected = Number;
let captured: Selected = 1;
Selected = String;
captured = 2;
println(captured);

let bodyCount = 0;
let annotated = (a: Number, b: String) -> { bodyCount = bodyCount + 1; std.Number.toString(a) + b; };
println(annotated(2, "x"));
println(annotated("x", "x").type);
println(annotated("x", "x").message);
println(bodyCount);
let part = annotated("bad");
println(Function.check(part));
println(part("x").type);
println(bodyCount);
let reassign = (v: Number) -> { v = "bad"; v; };
println(reassign(1).message);
let ParamType = Number;
let capturedParam = (v: ParamType) -> v;
ParamType = String;
println(capturedParam(8));
println(capturedParam("x").type);
let badParam = (v: null) -> 42;
println(badParam(1).type);
let badCheck = (v: Broken) -> 42;
println(badCheck(1).type);
let duplicate = (v: String, v: Number) -> { v = 9; v; };
println(duplicate("first", 2));
println(duplicate(1, 2).type);
let noCheckOnLast = (v: Number, v) -> { v = "last"; v; };
println(noCheckOnLast(1, 2));

// Visibility and captured bindings follow declarations; each block owns state.
let outer = 10;
if true {
  println(outer);
  let outer: Number = outer + 1;
  println(outer);
  outer = "bad";
  println(outer.type);
};
println(outer);
let get = null;
let set = null;
if true {
  let local: Number;
  get = () -> local;
  set = (v) -> { local = v; };
};
println(get().type);
set(5);
println(get());
set("bad");
println(get().type);
let even;
let odd;
even = (n: Number) -> { if n == 0 { true; } else { odd(n - 1); }; };
odd = (n: Number) -> { if n == 0 { false; } else { even(n - 1); }; };
println(even(8));
// An uninitialized local read is now a frontend error, including inside a
// function body; the frontend diagnostic fixture covers it.
let slots = [];
let i = 0;
while i < 3 { let slot: Number; slot = i; slots[i] = () -> slot; i = i + 1; };
println(slots[0]());
println(slots[2]());

let shadowed: Number = 3;
if true { let shadowed; shadowed = "free"; println(shadowed); };
println(shadowed);
let annotationCalls = 0;
let captureType = () -> { annotationCalls = annotationCalls + 1; Number; };
let defineOnce = (a, b: captureType()) -> b;
println(annotationCalls);
println(defineOnce(null, 4));
println(defineOnce(null, 5));
println(annotationCalls);
let ErrorPredicate = std.Type.make((v) -> isError(v));
let acceptedError: ErrorPredicate = error;
println(acceptedError.type);
let NativePredicate = std.Type.make(std.String.length);
let rejectedError: NativePredicate = error;
println(rejectedError.type);
println(rejectedError.cause.type);
let sideEffects = 0;
let sideEffect = () -> { sideEffects = sideEffects + 1; 1; };
let badType = () -> std.Error.raise("BadType", "stop", null);
let failedDeclaration = () -> { let x: badType()? = sideEffect(); 99; };
println(failedDeclaration().type);
println(sideEffects);
let failedDefinition = () -> { let f = (x: badType()?) -> x; sideEffect(); };
println(failedDefinition().type);
println(sideEffects);

let nullMismatch: Number = null;
println(nullMismatch.message);
let objectMismatch: Number = Number;
println(objectMismatch.message);
let arrayMismatch: Number = [];
println(arrayMismatch.message);

// Executed empty branches clear the previous statement value; a skipped branch keeps it.
let clearedThen = () -> { let x = 0; x; if true { let y = 2; }; };
let clearedElse = () -> { let x = 0; x; if false { 1; } else {}; };
let kept = () -> { let x = 0; x; if false { 1; }; };
println(isError(clearedThen()));
println(isError(clearedElse()));
println(kept().type);
let keptAcrossStatements = () -> { let x = 0; x; let y = 1; y = 1; while false { 3; }; };
println(keptAcrossStatements().type);
