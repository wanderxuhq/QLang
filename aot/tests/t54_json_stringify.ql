let stringify = std.JSON.stringify;
let checks = 0;
let check = (ok, label) -> {
  checks = checks + 1;
  if !ok { return std.Error.raise("AssertionFailed", label, null); };
  null;
};

check(stringify(null) == "null", "null")?;
check(stringify(true) == "true", "true")?;
check(stringify(false) == "false", "false")?;
check(stringify(42) == "42", "integer")?;
check(stringify(-2.5) == "-2.5", "fraction")?;
check(stringify("中文é😀") == '"中文é😀"', "Unicode scalars")?;
check(stringify("A\"\\\u0000\n中😀") == '"A\\"\\\\\\u0000\\n中😀"',
      "quote, slash, NUL, newline and Unicode")?;
check(stringify([1, "a,b", true, null, []]) == '[1,"a,b",true,null,[]]',
      "Array traversal")?;
check(stringify({ a: [1, "x"] }) == '{"a":[1,"x"]}', "Object traversal")?;
check(stringify(Number) == '{"check":null}', "built-in Type value is an object")?;
let madeType = std.Type.make((value) -> Number.check(value));
check(stringify(madeType) == '{"check":null}', "constructed Type value is an object")?;
let typeRoundTrip = std.JSON.parse(stringify(madeType));
check(typeRoundTrip.check == null, "Type output parses as ordinary object")?;
let fn = (value) -> value;
check(stringify(fn) == "null", "root function becomes null")?;
let storedError = std.Error.raise("Stored", "inside container", null);
check(stringify([storedError, fn]) == "[null,null]", "Array Errors and functions become null")?;
check(stringify({ error: storedError }) == '{"error":null}', "Object Error becomes null")?;
let ordinary = { a: [1, "x"], ok: true };
let ordinaryRoundTrip = std.JSON.parse(stringify(ordinary));
check(ordinaryRoundTrip.a[0] == 1 && ordinaryRoundTrip.a[1] == "x" && ordinaryRoundTrip.ok == true,
      "ordinary object parses with its fields")?;
let ordered = { zebra: 1, alpha: 2, middle: 3 };
let orderedKeys = std.Object.keys(ordered);
let orderedExpected = "{";
let orderIndex = 0;
while orderIndex < orderedKeys.length {
  if orderIndex > 0 { orderedExpected = orderedExpected + ","; };
  let orderKey = orderedKeys[orderIndex];
  orderedExpected = orderedExpected + "\"" + orderKey + "\":" + std.Number.toString(ordered[orderKey]);
  orderIndex = orderIndex + 1;
};
orderedExpected = orderedExpected + "}";
check(stringify(ordered) == orderedExpected, "uses Object.keys enumeration order")?;
let shared = { value: 7 };
check(stringify([shared, shared]) == '[{"value":7},{"value":7}]',
      "shared reference is not a cycle")?;
let partial = stringify();
check(partial("partial") == '"partial"', "ordinary partial call")?;
check(stringify(1, 2).type == "ArityMismatch", "ordinary excess-argument error")?;
let rootError = std.Error.raise("Root", "root cause", null);
let rootFailure = stringify(rootError);
check(rootFailure.type == "TypeMismatch" && rootFailure.cause.message == "root cause",
      "root Error follows ordinary call rejection with cause")?;
check(stringify(1e308 * 1e308) == "null", "non-finite value remains null")?;

// Finite values are the established Number formatting cases from t47.
// This implementation delegates number conversion to std.Number.toString.
let numberCases = [
  0, -0, 1, -1, 10, -10, 9007199254740991, -9007199254740991,
  9007199254740992, 9007199254740994, 1e20, 1e-13, 1 / 3, 1 / 7,
  0.1 + 0.2, 1.0000000000000002, 2.2250738585072014e-308, 5e-324,
  1.7976931348623157e308
];
let i = 0;
while i < numberCases.length {
  let number = numberCases[i];
  check(stringify(number) == std.Number.toString(number),
        "finite Number.toString rendering")?;
  i = i + 1;
};

let selfArray = [];
selfArray[0] = selfArray;
let selfArrayFailure = stringify(selfArray);
check(selfArrayFailure.type == "TypeMismatch" &&
      selfArrayFailure.message == "JSON.stringify nesting too deep", "Array self-cycle rejected")?;
let selfObject = {};
selfObject.self = selfObject;
let selfObjectFailure = stringify(selfObject);
check(selfObjectFailure.type == "TypeMismatch" &&
      selfObjectFailure.message == "JSON.stringify nesting too deep", "Object self-cycle rejected")?;
let mixedObject = {};
let mixedArray = [mixedObject];
mixedObject.back = mixedArray;
let mixedArrayFailure = stringify(mixedArray);
check(mixedArrayFailure.type == "TypeMismatch" &&
      mixedArrayFailure.message == "JSON.stringify nesting too deep", "mixed Array/Object cycle rejected")?;

// Depth is counted from the root value. Expected strings are built from the
// explicit container count rather than generated by the candidate.
let depthNull = null;
let expectedNull = "null";
i = 0;
while i < 128 {
  depthNull = [depthNull];
  expectedNull = "[" + expectedNull + "]";
  i = i + 1;
};
check(stringify(depthNull) == expectedNull, "128 nested Arrays around null")?;
let tooDeepNull = [depthNull];
let depthFailure = stringify(tooDeepNull);
check(depthFailure.type == "TypeMismatch" &&
      depthFailure.message == "JSON.stringify nesting too deep",
      "129 nested Arrays around null fail at depth limit")?;
let depthEmpty = [];
let expectedEmpty = "[]";
i = 0;
while i < 128 {
  depthEmpty = [depthEmpty];
  expectedEmpty = "[" + expectedEmpty + "]";
  i = i + 1;
};
check(stringify(depthEmpty) == expectedEmpty,
      "empty container at depth 128 is accepted")?;
let tooDeepEmpty = [depthEmpty];
let emptyFailure = stringify(tooDeepEmpty);
check(emptyFailure.type == "TypeMismatch" &&
      emptyFailure.message == "JSON.stringify nesting too deep",
      "empty container at depth 129 is rejected")?;

let verifyCount = (actual) -> {
  if actual != 48 {
    return std.Error.raise("AssertionFailed",
      "expected 48 JSON stringify checks, got " + std.String.toString(actual), null);
  };
  null;
};
verifyCount(checks)?;
println("JSON stringify checks: " + std.String.toString(checks));
