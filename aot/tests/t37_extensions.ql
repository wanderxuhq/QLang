let checks = 0;
let check = (ok, label) -> { checks = checks + 1; if !ok { println("FAIL " + label); }; };
let pathCalls = 0;
let path = () -> { pathCalls = pathCalls + 1; args[0]; };
let p = import (path());
check(pathCalls == 1, "path evaluated exactly once");
check(p.answer == 42 && p.label == "插件 😀", "independent module and embedded static dependency");
check(p.add(3, 4) == 7, "function across DSO");
check(p.add(3)(5) == 8, "partial application across DSO");
check(p.add("x", 1).type == "TypeCheck", "extension annotation");
check(p.add(1, 2, 3).type == "ArityMismatch", "extension arity");
check(p.numberType == Number && p.nullType == Null && p.errorType == Error, "canonical type identities");
check(std.Type.of(p.answer) == p.numberType, "host and extension type identity");
check(p.error.message == "exported", "Error is an exported value");
let closure = p.make(10);
check(closure(3) == 13, "escaped extension closure");
let object = {value: 1}; let array = [2];
check(p.mutate(object, array) == object && object.value == 9 && array[0] == 7, "shared object and array identity");
check(p.apply((x) -> x * 2, 6) == 12, "host callback from extension");
check(p.annotated(Number)(7) == 7, "host type captured in extension annotation");
check(p.bump() == 1 && p.bump() == 2, "extension captured state");
let again = import (args[0]);
check(again.bump() == 1 && p.bump() == 3, "fresh module state per import");
p.later();
check(p.late == 19 && again.late.type == "UndefinedField", "late export uses defining namespace");
let second = import (args[1]);
check(second.answer == 91 && second.label == "second" && second.add(7, 2) == 5, "multiple DSO symbols isolated");
check(p.add(7, 2) == 9 && p.label == "插件 😀", "first DSO remains callable");
let nested = () -> { let m = import (args[0]); m.make(20); };
check(nested()(4) == 24, "function-local import with escaping closure");
if false { import ("./missing.so"); };
check(true, "untaken dynamic import does not load");
let fail = import (args[2]); let failAgain = import (args[2]);
check(fail.message == "initialization failed" && failAgain.message == fail.message, "failed initialization clears guard");
let cycle = import (args[3]); let cycleAgain = import (args[3]);
check(cycle.type == "ImportCycle" && cycleAgain.type == "ImportCycle", "active cycle and guard cleanup");
let wrongABI = import (args[4]);
check(wrongABI.type == "ImportABI", "incompatible native module rejected");
let wrongFile = import (args[5]);
check(wrongFile.type == "ImportError", "source text is not a native module");
let invalid = import (17);
check(invalid.type == "TypeMismatch", "computed path must be a String");
let empty = import ("");
check(empty.type == "ImportError", "empty path rejected");
let noEntry = import (args[6]);
check(noEntry.type == "ImportError", "missing entry rejected");
// Keep DSO code, static strings, shared objects and host callbacks live through allocation pressure.
let i = 0;
while i < 60000 { let garbage = [i, {a: i, b: "x"}]; i = i + 1; };
check(closure(9) == 19 && p.label == "插件 😀" && object.value == 9, "extension values survive allocation pressure");
println("extension checks: " + std.String.toString(checks));
