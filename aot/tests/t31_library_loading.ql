// The default std uses ordinary QLang closures from the shared library source.
let checks = 0;
let check = (ok, name) -> { checks = checks + 1; if !ok { println("FAIL " + name); }; };
check(std.String.toUpperCase("Straße ﬃ") == "STRASSE FFI", "default Unicode library");
check(std.String.toLowerCase("ΟΣ ΟΣΑ") == "ος οσα", "default sigma context");
check(std.String.replace("aaaa")("aa")("X") == "XX", "default all-match replacement");
check(std.String.trim("\t\u{2028}x\u{3000}") == "x", "default whitespace library");
check(std.String.repeat("x")(0.5).type == "RangeError", "default count guard");
let length = std.String.length();
check(Function.check(length) && length("中😀") == 2, "ordinary language partial application");
let concat = std.String.concat("a");
check(concat("b") == "ab", "ordinary binary partial");
let trim = std.String.trim;
let upper = std.String.toUpperCase;
std.String.trim = (s) -> "caller";
std.Error.raise = (a, b, c) -> "caller";
std.Object.keys = (o) -> [];
let String = {check: (v) -> false};
check(trim(" x ") == "x" && upper("é") == "É", "library private bindings");
check(trim(42).type == "TypeMismatch", "library private Error constructor");
let get = std.Array.get; let pop = std.Array.pop;
let AnyArray = {check: (v) -> false};
check(get([7])(0) == 7 && pop([9])() == 9, "Array library private bindings");
check(get(42).type == "TypeMismatch", "Array private Error constructor");
std.Array.get = (a) -> (i) -> "caller";
let first = import ./modules/library_namespace.ql;
let second = import ./modules/library_namespace.ql;
check(first.defaultTrim == "module" && second.defaultTrim == "module", "each import gets standard library");
check(first.namespace != second.namespace, "fresh namespace tables");
check(first.saved(" x ") == "x" && second.saved(" y ") == "y", "module mutation preserves aliases");
check(std.String.trim("x") == "caller", "imports preserve caller namespace");
check(first.arrayGet(0) == 42 && second.arrayGet(0) == 42, "each import gets Array library");
check(first.arrayNamespace != second.arrayNamespace, "fresh Array namespaces");
check(std.Array.get([])(0) == "caller", "imports preserve caller Array namespace");
println("library loading checks: " + std.String.toString(checks));
