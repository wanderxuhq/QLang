let count = 0;
let check = (ok, label) -> { count = count + 1; if !ok { println("FAIL " + label); }; };
let p = import (args[0]);
let expectedTypes = [Number, String, Boolean, Null, AnyArray, AnyObject, Function, Error, Any, Never, std.Type];
let i = 0; let typesOK = true;
while i < expectedTypes.length { if p.types[i] != expectedTypes[i] { typesOK = false; }; i = i + 1; };
check(typesOK, "all canonical types retain identity");
let o = {n: 1}; o.self = o; let a = [o, o];
check(p.identity(a) == a, "container identity round trip");
p.save(a);
check(p.read() == a && p.read()[0] == o && p.read()[1].self == o, "stored alias and cycle");
o.n = 12;
check(p.read()[0].n == 12, "retained native reference sees later core write");
let r = p.callAfterWrite((x) -> { let n = x.n; x.n = n + 2; x; }, o);
check(r.object == o && r.result == o && r.n == 42 && o.n == 42, "reentrant callback sees writes in both directions");
let cycle = p.makeCycle();
check(cycle.type == "Object" && cycle.value == 7 && cycle.self == cycle, "native object with representation-like fields and cycle");
let sum = (x, y) -> x + y;
check(p.call(sum, 3, 4) == 7, "multiple callback arguments");
check(p.identity(sum) == sum, "callback identity round trip");
check(p.identity(sum)(2)(3) == 5, "returned callback partial application");
let remaining = sum(10);
check(p.identity(remaining) == remaining && p.identity(remaining)(2) == 12, "partial callback identity");
let positive = std.Type.make((v) -> Number.check(v) && v > 0);
check(p.annotated(positive)(3) == 3 && p.annotated(positive)(-1).type == "TypeCheck", "interpreted type checks native parameter");
let typed = (v: p.positive) -> v;
check(typed(5) == 5 && typed(0).type == "TypeCheck", "native type checks interpreted parameter");
let err = Error.raise("bridged");
let errType = std.Type.make((v) -> isError(v));
let checkedError = p.checkStored(errType, {value: err});
check(checkedError.message == "bridged", "predicate Error exemption crosses callback");
let reject = p.call((x, y) -> x, err, 1);
check(reject.type == "TypeMismatch", "ordinary native call rejects Error argument");
let after = p.shrink(a);
check(after == a && a.length == 1 && a[0] == o, "array shrink preserves aliases");
check(p.arguments == args && p.arguments[0] == args[0], "extension shares interpreted script arguments");
check(p.identity(sum).params.type == "NotAnObject", "callback representation hidden");
check(p.identity.name.type == "NotAnObject", "ordinary extension function name hidden");
check(p.annotated(Number).name.type == "NotAnObject", "escaped ordinary extension name hidden");
let nativePartial = p.call(sum);
check(nativePartial.name == "<curried>", "native partial name retained");
check("${nativePartial}" == "<native fn <curried>>", "native partial interpolation");
check(nativePartial(1, 2) == 3, "native partial completed with callback");
check(p.isPrint(println), "native function identity across modules");

// JSON stringify crosses the dynamic extension boundary as an ordinary function.
check(p.stringify([{unicode: "中文é😀"}, {nested: [1, true, null]}]) == '[{"unicode":"中文é😀"},{"nested":[1,true,null]}]', "JSON nested containers and Unicode");
let jsonError = std.Error.raise("Stored", "inside", null);
let jsonCallback = (v) -> v;
let jsonTagged = std.JSON.parse(p.stringify({type: "Number", value: 7}));
check(p.stringify([jsonError, jsonCallback]) == "[null,null]" && jsonTagged.type == "Number" && jsonTagged.value == 7, "JSON Error/function values and ordinary type/value fields");
let stringifyPartial = p.stringify();
check(stringifyPartial("partial") == '"partial"', "JSON stringify partial call across extension");
let jsonRootError = std.Error.raise("Root", "cross-boundary cause", null);
let jsonRejected = p.stringify(jsonRootError);
check(jsonRejected.type == "TypeMismatch" && jsonRejected.cause.message == "cross-boundary cause", "JSON root Error rejection preserves cause");
let jsonCycle = []; jsonCycle[0] = jsonCycle;
let jsonCycleError = p.stringify(jsonCycle);
check(jsonCycleError.type == "TypeMismatch" && jsonCycleError.message == "JSON.stringify nesting too deep", "JSON self-reference reaches depth guard");
if count != 28 {
  std.Error.raise("AssertionFailed", "expected 28 extension bridge checks, got " + std.String.toString(count), null)?;
};
println("extension bridge checks: " + std.String.toString(count));
