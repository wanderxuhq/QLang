// String contracts use fixed expectations independently of the retained Rust host.
let checks = 0; let failures = 0;
let check = (ok, name) -> {
  checks = checks + 1;
  if !ok { failures = failures + 1; println("FAIL " + name); };
};
let invalid = [null, 42, true, [], {}, x -> x];
let unary = [std.String.length, std.String.trim, std.String.toUpperCase, std.String.toLowerCase, std.String.includes, std.String.replace, std.String.split, std.String.repeat, std.String.startsWith, std.String.endsWith];
let i = 0;
while i < invalid.length {
  let j = 0;
  while j < unary.length {
    check(unary[j](invalid[i]).type == "TypeMismatch", "String receiver validation"); j = j + 1;
  };
  check(std.String.concat(invalid[i], "x").type == "TypeMismatch", "concat first receiver");
  check(std.String.concat("x", invalid[i]).type == "TypeMismatch", "concat second receiver");
  check(std.String.at(invalid[i], 0).type == "TypeMismatch", "at receiver");
  check(std.String.at("x", invalid[i]).type == if Number.check(invalid[i]) { "IndexOutOfBounds" } else { "TypeMismatch" }, "at invalid index");
  check(!std.String.includes("x")(invalid[i]), "includes non-String fallback");
  check(!std.String.startsWith("x")(invalid[i]), "startsWith non-String fallback");
  check(!std.String.endsWith("x")(invalid[i]), "endsWith non-String fallback");
  check(std.String.replace("x")(invalid[i])("y") == "x", "replace pattern fallback");
  check(std.String.replace("x")("x")(invalid[i]) == "x", "replace replacement fallback");
  check(std.String.split("x")(invalid[i])[0] == "x", "split fallback");
  if !Number.check(invalid[i]) { check(std.String.repeat("x")(invalid[i]) == "x", "repeat non-Number fallback"); }
  else { check(std.String.repeat("x")(invalid[i]).length == invalid[i], "repeat Number count"); };
  check(std.String.join([1, 2])(invalid[i]) == "", "String join fallback");
  i = i + 1;
};
let badArrays = [null, 42, true, "text", {}, x -> x]; i = 0;
while i < badArrays.length { check(std.String.join(badArrays[i]).type == "TypeMismatch", "join receiver"); i = i + 1; };
check(std.String.replace("aaaa")("aa")("X") == "XX", "replace every non-overlapping match");
check(std.String.replace("aaa")("aa")("X") == "Xa", "replace overlap");
check(std.String.replace("ababa")("b")("長😀") == "a長😀a長😀a", "replace expansion");
check(std.String.replace("ababa")("b")("") == "aaa", "replace deletion");
check(std.String.replace("中😀") ("") ("-") == "-中-😀-", "empty replacement pattern scalar boundaries");
check(std.String.replace("") ("") ("x") == "x", "empty replacement input");
check(std.String.replace("abc")("xyz")("q") == "abc", "replace missing pattern");
check(std.String.replace("a\0a")("\0")("-") == "a-a", "replace embedded NUL");
let parts = std.String.split("中😀") ("");
check(parts.length == 4 && parts[0] == "" && parts[1] == "中" && parts[2] == "😀" && parts[3] == "", "empty split Unicode scalars");
parts = std.String.split("aaaaa")("aa");
check(parts.length == 3 && parts[0] == "" && parts[1] == "" && parts[2] == "a", "split overlap and trailing rest");
parts = std.String.split("a::b::")("::");
check(parts.length == 3 && parts[2] == "", "split trailing empty");
check(std.String.split("")("").length == 2 && std.String.split("")(",").length == 1, "empty split input");
check(std.String.split("ab")("abc")[0] == "ab", "split partial suffix is not match");
check(std.String.repeat("中😀\0")(2) == "中😀\0中😀\0", "repeat preserves UTF-8 and NUL");
check(std.String.repeat("x")(0) == "" && std.String.repeat("x")(-0) == "", "zero repeat");
check(std.String.repeat("")(std.Number.parseFloat("1e100")) == "", "empty repeat does not iterate count");
let nan = std.Number.parseFloat("NaN"); let inf = std.Number.parseFloat("inf");
let badCounts = [-1, 1.5, -0.5, nan, inf, -inf, 2147483648, std.Number.parseFloat("1e100")]; i = 0;
while i < badCounts.length {
  check(std.String.repeat("x")(badCounts[i]).type == "RangeError", "repeat invalid count"); i = i + 1;
};
check(std.String.repeat("😀")(536870912).type == "RangeError", "repeat resource bound");
check(std.String.includes("中😀文")("😀") && std.String.includes("") (""), "includes Unicode and empty");
check(std.String.startsWith("中😀")("中") && std.String.endsWith("中😀")("😀"), "Unicode prefix and suffix");
check(!std.String.startsWith("a")("ab") && !std.String.endsWith("a")("ba"), "long prefix and suffix");
check(std.String.startsWith("")("") && std.String.endsWith("")(""), "empty prefix and suffix");
check(std.String.length("a中😀\0") == 4 && std.String.at("a中😀\0", -2) == "😀", "scalar indexing");
let badIndices = [-5, 4, 0.5, nan, inf, -inf]; i = 0;
while i < badIndices.length {
  check(std.String.at("a中😀\0", badIndices[i]).type == "IndexOutOfBounds", "at bad index");
  i = i + 1;
};
check(std.String.toUpperCase("Straße ﬃ é Ελληνικά 𐐨") == "STRASSE FFI É ΕΛΛΗΝΙΚΆ 𐐀", "full Unicode upper mapping");
check(std.String.toLowerCase("İ É 𐐀") == "i\u{307} é 𐐨", "full Unicode lower mapping");
check(std.String.toLowerCase("ΟΣ ΟΣΑ Σ") == "ος οσα σ", "contextual final sigma");
check(std.String.toLowerCase("Α\u{301}Σ\u{301}") == "α\u{301}ς\u{301}", "sigma ignores combining marks");
check(std.String.toLowerCase("Α'Σ'Α") == "α'σ'α", "sigma sees cased letter beyond apostrophe");
check(std.String.toLowerCase("\u{345}Σ") == "\u{345}σ", "case-ignorable takes precedence over cased");
check(std.String.toLowerCase("AΣ\u{345}") == "aς\u{345}", "trailing cased-and-ignorable scalar");
check(std.String.toUpperCase("中😀\0") == "中😀\0" && std.String.toLowerCase("") == "", "unmapped scalars and empty case conversion");
check(std.String.trim("\t\n\r\u{85}\u{a0}\u{1680}\u{2003}\u{2028}\u{2029}\u{202f}\u{205f}\u{3000}x\u{3000}") == "x", "Unicode whitespace trim");
check(std.String.trim(" \t\n") == "" && std.String.trim("") == "", "all whitespace and empty trim");
check(std.String.trim("\u{200b}x\u{feff}") == "\u{200b}x\u{feff}", "non-whitespace preserved");
check(std.String.trim("  x \t y  ") == "x \t y", "interior whitespace preserved");
check(std.String.join([[1], {n: 2}, null])("|") == "[1]|{n: 2}|null", "join uses language interpolation");
let stored = Error.raise("stored");
check(std.String.join([stored])("|") == std.Error.toString(stored), "join stored Error as data");
let join = std.String.join([1,2]); let repeat = std.String.repeat("ab");
check(repeat(2) == "abab" && repeat(1,2).type == "ArityMismatch", "repeat alias and arity");
check(join(1,2).type == "ArityMismatch", "join alias arity");
let err = repeat(stored);
check(err.type == "TypeMismatch" && err.cause.message == "stored", "repeat Error policy");
err = std.String.replace("abc")(stored);
check(err.type == "TypeMismatch" && err.cause.message == "stored", "replace Error policy at intermediate stage");
err = std.String.trim(stored);
check(err.type == "TypeMismatch" && err.cause.message == "stored", "trim Error policy");
println("string checks: " + std.String.toString(checks));
