// QLang contracts: receiver validation, safe indices, stored values and identity.
let checks = 0; let failures = 0;
let check = (ok, name) -> {
  checks = checks + 1;
  if !ok { failures = failures + 1; println("FAIL " + name); };
};
let invalid = [null, 42, true, "text", {}, x -> x];
let operations = [std.Array.length, std.Array.add, std.Array.remove, std.Array.push, std.Array.pop, std.Array.get, std.Array.indexOf, std.Array.includes, std.Array.join, std.Array.reverse, std.Array.concat];
let i = 0;
while i < invalid.length {
  let j = 0;
  while j < operations.length {
    check(operations[j](invalid[i]).type == "TypeMismatch", "Array receiver");
    j = j + 1;
  };
  check(std.Array.at(invalid[i], 0).type == "TypeMismatch", "at receiver");
  check(std.Array.concat([])(invalid[i]).type == "TypeMismatch", "concat second receiver");
  i = i + 1;
};
let a = [10, 20, 30]; let get = std.Array.get(a); let remove = std.Array.remove(a);
check(get(0) == 10 && get(-1) == 30 && get(-3) == 10, "get integer and negative indices");
check(std.Array.at(a, -1) == 30, "strict negative index");
let badKeys = [null, "0", true, [], {}, x -> x]; i = 0;
while i < badKeys.length {
  check(get(badKeys[i]) == null, "get non-number index");
  check(remove(badKeys[i]) == null && a.length == 3, "remove non-number leaves Array intact");
  check(std.Array.at(a, badKeys[i]).type == "TypeMismatch", "at non-number index");
  i = i + 1;
};
let nan = std.Number.parseFloat("NaN"); let inf = std.Number.parseFloat("inf");
let badIndices = [1.5, -0.5, nan, inf, -inf, 3, -4]; i = 0;
while i < badIndices.length {
  check(get(badIndices[i]) == null, "get invalid number index");
  check(remove(badIndices[i]) == null && a.length == 3, "remove invalid number leaves Array intact");
  check(std.Array.at(a, badIndices[i]).type == "IndexOutOfBounds", "at invalid number index");
  i = i + 1;
};
check(a[0] == 10 && a[1] == 20 && a[2] == 30, "failed removals preserve contents");
check(remove(-2) == null && a.length == 2 && a[1] == 30, "valid removal shifts values");
check(std.Array.add(a)(40) == null && get(-1) == 40, "add returns null and aliases observe growth");
check(std.Array.push(a)(50) == 4 && get(-1) == 50, "push returns new length");
let pop = std.Array.pop(a);
check(pop() == 50 && a.length == 3, "pop returns removed value");
check(std.Array.pop([])() == null, "empty pop");
let original = Error.raise("stored"); let fn = (x) -> x + 1; let child = { n: 1 }; let list = [2];
let stored = [original, fn, child, list, null];
check(std.Array.indexOf(stored)(child) == 2, "Error element does not cause false search match");
check(!std.Array.includes([original])(999), "Error element not truthy equality");
check(std.Array.get(stored)("0") == null, "index String is not coerced");
let retrieved = std.Array.get(stored)(0);
check(isError(retrieved) && retrieved.message == "stored", "get preserves Error");
retrieved = std.Array.at(stored, 0);
check(isError(retrieved) && retrieved.message == "stored", "at preserves Error");
check(std.Array.get(stored)(1)(4) == 5, "get preserves function callability");
check(std.Array.at(stored, 1) == fn, "at preserves function identity");
let reversed = std.Array.reverse(stored);
check(reversed.length == 5 && stored.length == 5, "reverse is a full shallow copy");
retrieved = std.Array.get(reversed)(4);
check(isError(retrieved) && retrieved.message == "stored", "reverse preserves Error");
check(reversed[1] == list && reversed[2] == child && reversed[3] == fn, "reverse preserves aliases");
let combined = std.Array.concat([original, child])([list, fn, original]);
check(combined.length == 5, "concat preserves every element");
retrieved = std.Array.get(combined)(4);
check(isError(retrieved) && retrieved.message == "stored", "concat preserves Error");
check(combined[1] == child && combined[2] == list && combined[3] == fn, "concat shallow aliases");
let errorArray = [original]; retrieved = std.Array.pop(errorArray)();
check(errorArray.length == 0 && isError(retrieved) && retrieved.message == "stored", "pop removes and returns stored Error");
let fnArray = [fn]; check(std.Array.pop(fnArray)()(8) == 9, "pop returns callable function");
let collection = []; std.Array.add(collection)(child); std.Array.push(collection)(list); std.Array.push(collection)(fn);
let got = std.Array.get(collection)(0); got.n = 7;
check(child.n == 7, "add retains Object alias");
got = std.Array.at(collection, 1); got.add(3);
check(list.length == 2 && list[1] == 3, "push retains Array alias");
check(std.Array.get(collection)(2)(9) == 10, "push retains interpreted function");
let data = [1, true, "1", null, child, list, fn];
let search = std.Array.indexOf(data); let includes = std.Array.includes(data);
check(search(1) == 0 && search(true) == 1 && search("1") == 2 && search(null) == 3, "scalar search respects types");
check(search(child) == 4 && search(list) == 5 && search(fn) == 6, "search finds same references");
check(search({ n: 7 }) == -1 && search([2, 3]) == -1 && search(x -> x + 1) == -1, "search does not compare aggregates structurally");
check(includes(child) && !includes({ n: 7 }), "includes uses identity");
check(std.Array.indexOf([nan, 0])(-0) == 1 && !std.Array.includes([nan])(nan), "NaN and signed zero equality");
let cyclic = []; cyclic.add(cyclic);
check(std.Array.indexOf(cyclic)(cyclic) == 0 && !std.Array.includes(cyclic)([]), "cyclic Array search terminates");
let cycleObject = {}; cycleObject.self = cycleObject;
check(std.Array.includes([cycleObject])(cycleObject) && !std.Array.includes([cycleObject])({}), "cyclic Object search terminates");
check(std.Array.join([1, true, null])("|") == "1|true|null", "join renders values");
check(std.Array.join([1, 2])(null) == "1,2", "join default separator for non-String");
check(std.Array.join([[1, 2], { n: 3 }])("|") == "[1, 2]|{n: 3}", "join renders nested wrappers");
check(std.Array.toString([1, [2], null]) == "[1, [2], null]", "Array conversion renders nested wrappers");
check(std.Array.toString(42) == "42" && std.Array.toString(null) == "null", "Array conversion keeps generic fallback");
i = 0;
while i < operations.length {
  let e = operations[i](original);
  check(e.type == "TypeMismatch" && e.cause.message == "stored", "receiver Error policy");
  i = i + 1;
};
let e = std.Array.push(a)(original);
check(e.type == "TypeMismatch" && e.cause.message == "stored" && a.length == 3, "push rejects Error without modifying Array");
e = search(original);
check(e.type == "TypeMismatch" && e.cause.message == "stored", "search Error cause");
e = get(1, 2);
check(e.type == "ArityMismatch", "get alias arity");
e = search(1, 2);
check(e.type == "ArityMismatch", "search alias arity");
check(isError(get.name) && isError(search.name), "ordinary function metadata");
let deferred = std.Array.get(collection); collection.add(55);
check(deferred(-1) == 55, "curried lookup sees subsequent mutation");
let fake = { type: "Number", value: 123 }; std.Array.add(collection)(fake);
check(std.Array.get(collection)(-1) == fake && std.Array.get(collection)(-1).type == "Number", "wrapper-like user object preserved");
let native = std.Math.max; let natives = [native];
check(std.Array.get(natives)(0)(1, 5, 3) == 5, "get returns callable native function");
check(Function.check(std.Array.length()), "ordinary zero-argument partial");
check(std.Array.get([7])()(0) == 7, "ordinary curried zero-argument partial");
println("array checks: " + std.String.toString(checks));
