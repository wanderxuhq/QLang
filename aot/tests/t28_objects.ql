// Default Object API: strict assertions preserve stored Error values.
let checks = 0;
let check = (ok, name) -> {
  checks = checks + 1;
  if !ok { return std.Error.raise("AssertionFailed", name, null); };
  null;
};
let invalid = [null, 42, true, "text", [], x -> x];
let i = 0;
while i < invalid.length {
  let v = invalid[i];
  check(std.Object.keys(v).type == "TypeMismatch", "keys receiver")?;
  check(std.Object.values(v).type == "TypeMismatch", "values receiver")?;
  check(std.Object.merge(v).type == "TypeMismatch", "merge first receiver")?;
  check(std.Object.merge({})(v).type == "TypeMismatch", "merge second receiver")?;
  check(std.Object.hasOwn(v).type == "TypeMismatch", "hasOwn receiver")?;
  check(std.Object.get(v).type == "TypeMismatch", "get receiver")?;
  check(std.Object.field(v, "x").type == "TypeMismatch", "field receiver")?;
  i = i + 1;
};
let original = Error.raise("stored error");
let fn = (v) -> v + 1; let child = { n: 1 }; let list = [1];
let o = { present: null, error: original, f: fn, child: child, list: list, "": 7, "a\0b": 9, "中文": 11 };
check(std.Object.hasOwn(o)("present"), "null is present")?;
check(std.Object.hasOwn(o)("error"), "Error is present")?;
check(!std.Object.hasOwn(o)("missing"), "missing is absent")?;
check(std.Object.get(o)("present") == null, "stored null")?;
check(std.Object.get(o)("missing") == null, "missing get")?;
let retrieved = std.Object.get(o)("error");
check(isError(retrieved) && retrieved.message == "stored error", "get preserves Error")?;
retrieved = std.Object.field(o, "error");
check(isError(retrieved) && retrieved.message == "stored error", "field preserves Error")?;
let missing = std.Object.field(o, "missing");
check(missing.type == "UndefinedField" && missing.message == "Undefined field: missing", "strict missing field")?;
check(std.Object.get(o)("f") == fn, "function identity")?;
check(std.Object.get(o)("f")(3) == 4, "retrieved function callable")?;
check(std.Object.field(o, "f")(8) == 9, "strict retrieved function callable")?;
let gotChild = std.Object.get(o)("child"); gotChild.n = 12;
check(child.n == 12, "object alias")?;
let gotList = std.Object.field(o, "list"); gotList.add(2);
check(list.length == 2 && list[1] == 2, "Array alias")?;
check(std.Object.get(o)("") == 7, "empty key")?;
check(std.Object.get(o)("a\0b") == 9, "NUL key")?;
check(std.Object.field(o, "中文") == 11, "Unicode key")?;
let keys = [null, 1, true, [], {}, fn]; i = 0;
while i < keys.length {
  check(!std.Object.hasOwn(o)(keys[i]), "hasOwn non-String probe")?;
  check(std.Object.get(o)(keys[i]) == null, "get non-String probe")?;
  check(std.Object.field(o, keys[i]).type == "TypeMismatch", "field key type")?;
  i = i + 1;
};
let operations = [std.Object.keys, std.Object.values, std.Object.merge, std.Object.hasOwn, std.Object.get];
i = 0;
while i < operations.length {
  let e = operations[i](original);
  check(e.type == "TypeMismatch" && e.cause.message == "stored error", "receiver Error cause")?;
  i = i + 1;
};
let e = std.Object.field({}, original);
check(e.type == "TypeMismatch" && e.cause.message == "stored error", "field key Error cause")?;
e = std.Object.get(o)(original);
check(e.type == "TypeMismatch" && e.cause.message == "stored error", "get key Error cause")?;
e = std.Object.hasOwn(o)(original);
check(e.type == "TypeMismatch" && e.cause.message == "stored error", "hasOwn key Error cause")?;
e = std.Object.merge(o)(original);
check(e.type == "TypeMismatch" && e.cause.message == "stored error", "merge Error cause")?;
let merged = std.Object.merge(o)({ present: 5, added: 6 });
check(o.present == null && merged.present == 5 && merged.added == 6, "merge fresh result and right override")?;
check(std.Object.hasOwn(merged)("error"), "merge retains Error presence")?;
retrieved = std.Object.get(merged)("error");
check(retrieved.message == "stored error", "merge retains Error value")?;
check(merged.child == child && merged.f == fn, "merge shallow aliases")?;
let projection = std.Object.get(o); o.later = 23;
check(projection("later") == 23, "curried lookup sees later writes")?;
let lookalike = { type: "Number", value: 123 }; o.lookalike = lookalike;
check(std.Object.get(o)("lookalike") == lookalike, "wrapper-like user object preserved")?;
check(std.Object.field(o, "lookalike").type == "Number", "wrapper-like user fields preserved")?;
let large = {}; i = 0;
while i < 80 { large["k" + std.String.toString(i)] = i; i = i + 1; };
large.stored = original;
check(std.Object.keys(large).length == 81 && std.Object.values(large).length == 81, "grown table collection")?;
check(std.Object.hasOwn(large)("stored"), "grown table Error presence")?;
check(std.Object.get(large)("k79") == 79 && std.Object.get(large)("absent") == null, "grown table probing")?;
let values = std.Object.values({ only: original });
check(values.length == 1 && isError(values[0]) && values[0].message == "stored error", "values preserve Error")?;
let collected = std.Object.keys({ only: 1 }); collected.add("later");
check(collected.length == 2 && collected[1] == "later", "collected Array supports append")?;
e = std.Object.keys(fn, 1);
check(e.type == "ArityMismatch", "arity precedes function receiver validation")?;
let verifyCount = (actual) -> {
  if actual != 98 {
    return std.Error.raise("AssertionFailed", "expected 98 object checks, got " + std.String.toString(actual), null);
  };
  null;
};
verifyCount(checks)?;
println("object checks: " + std.String.toString(checks));
