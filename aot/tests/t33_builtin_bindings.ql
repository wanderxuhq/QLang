let checks = 0;
let check = (ok, label) -> { checks = checks + 1; if !ok { print("FAIL " + label + "\n"); }; };
let output = println; let errorCheck = isError;
let numberType = Number; let stringType = String; let arrayType = AnyArray; let errorType = Error;
let replacement = {check: (value) -> false};
Number = replacement; String = replacement; AnyArray = replacement;
Error = replacement; isError = (v) -> false;
check(Number == replacement && String == replacement && AnyArray == replacement, "module bindings remain assignable");
check(std.String.repeat("x")(3) == "xxx", "private Number and String bindings");
check(std.String.trim(" x ") == "x", "private isError binding");
check(std.Array.get([7])(0) == 7, "private Array validation and indexing");
check(std.Array.reverse([1, 2])[0] == 2, "private Array receiver check");
check(std.Type.of(1) == numberType && std.Type.of("x") == stringType, "canonical type identities");
check(std.Type.of([]) == arrayType, "canonical Array identity");
let failed = std.String.trim(42);
check(errorCheck(failed) && failed.type == "TypeMismatch", "library Error construction");
check(std.Type.of(failed) == errorType, "canonical Error identity");
let intercepted = 0;
println = (value) -> { intercepted = intercepted + 1; };
println("caller");
let first = import ./modules/builtin_bindings.ql;
check(intercepted == 1, "imported output binding is separate");
check(first.moduleNumber == numberType && first.moduleString == stringType, "import receives canonical builtins");
check(first.repeated == "xxx" && first.selected == 7 && first.trimmed == "x", "module mutation preserves private library");
check(Number == replacement && String == replacement && !isError(42), "module mutation preserves caller bindings");
let restore = () -> { Number = numberType; };
restore();
check(Number == numberType, "closure assignment reaches nearest lexical binding");
let second = import ./modules/builtin_bindings.ql;
check(second.moduleNumber == numberType && Number == numberType, "repeated import gets fresh bindings");
check(intercepted == 1, "repeated import keeps output binding");
let before = () -> Number;
let Number;
check(errorCheck(before()) && before().type == "Uninitialized", "uninitialized redeclaration hides previous builtin");
Number = numberType;
check(before() == numberType, "initialization restores captured binding");
let Type = 9;
check(Type == 9, "ordinary explicitly declared Type name");
// Builtin names obey the same lexical binding rules as ordinary variables.
if true {
  let Number = replacement;
  check(Number == replacement, "block declaration shadows outer binding");
  Number = stringType;
  check(Number == stringType, "block assignment updates its local binding");
  check(std.String.repeat("x")(3) == "xxx", "block shadow preserves library closure");
};
check(Number == numberType, "leaving block preserves outer binding");
let localFunction = () -> {
  let Number = replacement;
  let update = () -> { Number = stringType; };
  update();
  check(Number == stringType, "nested closure updates nearest function binding");
};
localFunction();
check(Number == numberType, "function local assignment preserves outer binding");
let parameterFunction = (Number) -> { Number = stringType; Number; };
check(parameterFunction(replacement) == stringType && Number == numberType, "parameter binding is local");
let readCaptured = null; let writeCaptured = null;
if true {
  let Number = replacement;
  readCaptured = () -> Number;
  writeCaptured = (value) -> { Number = value; };
};
writeCaptured(stringType);
check(readCaptured() == stringType && Number == numberType, "escaped closures share block binding");
if true {
  let Number;
  Number = replacement;
  check(Number == replacement, "assignment initializes nearest block binding");
};
check(Number == numberType, "block initialization preserves outer binding");
let __arr_add = 17;
check(__arr_add == 17, "explicit declaration may use internal-looking name");
output("builtin binding checks: " + std.String.toString(checks));
