// Native function metadata is also the calling convention of the core interpreter.
let output = println;
output(42);
let merge = std.Object.merge({left: 1});
println(merge({right: 2}).right);
println(std.String.toString([1, [true, null]]));
let decoded = std.JSON.parse('{"type":"user", "value":[1,true,null]}');
println(decoded.type);
println(decoded.value[1]);
println(std.JSON.stringify(decoded.value));
let raise = Error.raise;
let root = raise("root");
let outer = raise("outer", root);
println(root.type);
println(root.message);
println(root.cause == null);
println(outer.cause.type);
println(outer.cause.message);
println(Error.check(outer));
println(std.Type.of(outer) == Error);
println(raise(42).message);
println(raise("ignored", 42).cause == null);
println(isError((v -> v)(root)));
println(std.Error.raise("Custom", "message", root).cause.message);
let pending = null;
println(Null.check(pending));
println(std.Type.of(pending) == Null);
println(outer["type"]);
println(outer["cause"]["message"]);
println(outer["missing"].type);
println(outer[0].type);
// Assignment tests binding presence independently of its stored value.
let errorBinding = std.Error.raise("UndefinedVariable", "a stored error", null);
errorBinding = 7;
println(errorBinding);
let initialize = () -> { later = 9; };
let later;
initialize();
println(later);
let shadow = 1;
if true { let shadow; shadow = 2; println(shadow); };
println(shadow);
std = { answer: 42 };
println(std.answer);
