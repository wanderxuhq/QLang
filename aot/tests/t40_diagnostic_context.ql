let checks = 0;
let check = (ok, label) -> { checks = checks + 1; if !ok { println("FAIL " + label); }; };
let diagnostics = std.__diagnostics;
let p = {file: "interpreted.ql", line: 7, col: 9};
let before = diagnostics.enter(p);
let created = 1 / 0;
let fresh = diagnostics.error(created, p, true);
let other = {file: "caller.ql", line: 11, col: 3};
let saved = diagnostics.enter(other);
let reused = diagnostics.error(created, other, true);
let native = (x) -> 1 / 0;
let called = std.__callNative(native, [1]);
let calledTrace = diagnostics.error(called, other, true);
let afterNative = 1 / 0;
diagnostics.leave(saved);
let afterRestore = 1 / 0;
diagnostics.leave(before);
check(created.line == 7 && created.col == 9, "creation scope");
check(fresh.line == 7 && fresh.col == 9, "fresh error retains origin");
check(created.line == 7 && reused.line == 7, "reused error retains origin");
check(called.line == 11 && called.col == 21, "native boundary restores native source");
check(calledTrace.line == 11 && calledTrace.col == 21, "native boundary retains origin");
check(afterNative.line == 11 && afterNative.col == 3 && afterRestore.line == 7 && afterRestore.col == 9, "nested contexts restored");
let ordinary = 1 / 0;
check(ordinary.line == 24 && ordinary.col == 16, "no context leak");
let invalid = diagnostics.enter({file: "invalid", line: 1, col: 0});
check(invalid.type == "TypeMismatch", "invalid source rejected");
let following = 1 / 0;
check(following.line == 28 && following.col == 17, "invalid enter leaves context unchanged");
let partialFactory = (x, y) -> 1 / 0;
let partial = partialFactory(1);
let partialScope = diagnostics.enter(other);
let partialError = std.__callNative(partial, [2]);
diagnostics.leave(partialScope);
check(partialError.line == 30 && partialError.col == 32, "partial native source");
let unknownScope = diagnostics.enter(null);
let unknown = Error.raise("unknown");
let attached = diagnostics.error(unknown, p, false);
diagnostics.leave(unknownScope);
check(attached.line == 7 && attached.col == 9, "unknown source can be attached");
let parentScope = diagnostics.enter(p);
let inherited = diagnostics.enter(null);
let inheritedError = 1 / 0;
diagnostics.leave(inherited); diagnostics.leave(parentScope);
check(inheritedError.line == 7 && inheritedError.col == 9, "synthetic nodes inherit source scope");
println("diagnostic context checks: " + std.String.toString(checks));
if args.length > 0 && args[0] == "fresh" { fresh?; };
if args.length > 0 && args[0] == "reused" { reused?; };
if args.length > 0 && args[0] == "called" { calledTrace?; };
if args.length > 0 && args[0] == "after-native" { afterNative?; };
if args.length > 0 && args[0] == "after-restore" { afterRestore?; };
if args.length > 0 && args[0] == "ordinary" { ordinary?; };
if args.length > 0 && args[0] == "following" { following?; };
if args.length > 0 && args[0] == "partial" { partialError?; };
if args.length > 0 && args[0] == "attached" { attached?; };
if args.length > 0 && args[0] == "inherited" { inheritedError?; };
if args.length > 0 && args[0] == "same-point" { let prior = diagnostics.enter(p); let again = diagnostics.error(created, p, true); diagnostics.leave(prior); again?; };
