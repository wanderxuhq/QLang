// Fixed language contracts, shared by direct AOT and the QLang interpreter.
let checks = 0; let zero = 0;
let check = (ok, name) -> {
  if !ok { println("FAIL " + name); };
  checks = checks + 1;
};
check(isError(-true), "negate Boolean");
check(isError(-null), "negate null");
check(isError(-"text"), "negate String");
check(isError(-[]), "negate Array");
check(isError(-{}), "negate Object");
check(isError(-(x -> x)), "negate Function");
let original = Error.raise("original"); let negativeError = -original;
check(negativeError.type == "TypeMismatch", "negation error type");
check(negativeError.cause.message == "original", "negation error cause");
let effects = 0; let once = () -> { effects = effects + 1; true; };
let rejected = -once(); check(effects == 1 && isError(rejected), "single evaluation");
check(std.JSON.stringify(-0) == "-0", "negative zero");
let parse = std.Number.parseFloat;
let bad = ["", " ", "bad", "1e", "1e+", ".", "+", "1 2", "12tail", "0x10", "1_0", "--1"];
let i = 0;
while i < bad.length { check(std.Number.isNaN(parse(bad[i])), "invalid number"); i = i + 1; };
check(std.Number.isNaN(parse(null)), "non-string null");
check(std.Number.isNaN(parse(42)), "non-string Number");
check(std.Number.isNaN(parse([])), "non-string Array");
check(parse(" +.5 ") == 0.5, "sign and leading dot");
check(parse("1.e2") == 100, "trailing dot and exponent");
check(parse("00012.50") == 12.5, "leading zeros");
check(parse("\u{2003}-2.5\u{3000}") == -2.5, "Unicode whitespace");
check(std.JSON.stringify(parse("-0e99999")) == "-0", "signed zero exponent");
let inf = parse("infinity"); let nan = parse("NaN");
check(!std.Number.isFinite(inf) && inf > 0, "infinity spelling");
check(parse("-INF") < 0, "negative infinity spelling");
check(std.Number.isNaN(nan), "NaN spelling");
check(std.JSON.stringify(nan) == "null", "NaN JSON");
check(1 % 0.1 == 0.09999999999999995, "fractional remainder");
check(parse("1e308") % 3 == 2, "huge remainder");
check(std.JSON.stringify(-4 % 2) == "-0", "remainder signed zero");
check(3 % inf == 3, "infinite divisor");
check(std.Number.isNaN(inf % 3), "infinite dividend");
check((1 % zero).type == "DivisionByZero", "zero divisor");
check((nan | 0) == 0, "NaN bit conversion");
check((inf & 1) == 1, "positive saturation");
check((-inf & 1) == 0, "negative saturation");
check((3.9 ^ 1) == 2, "bit conversion truncates");
let near = (a, b) -> std.Math.abs(a - b) <= 0.000000000001 * std.Math.max(1, std.Math.abs(b));
check(near(std.Math.PI, 3.141592653589793), "PI");
check(near(std.Math.E, 2.718281828459045), "E");
check(std.Math.sqrt(parse("1e20")) == parse("1e10"), "large sqrt");
check(near(std.Math.sqrt(2), 1.4142135623730951), "irrational sqrt");
check(std.Math.sqrt(-1).type == "TypeMismatch", "negative sqrt");
check(std.Math.sqrt(nan).type == "TypeMismatch", "NaN sqrt");
check(std.Math.sqrt(inf) == inf, "infinite sqrt");
check(std.JSON.stringify(std.Math.sqrt(-0)) == "-0", "sqrt signed zero");
check(std.Math.pow(2)(-1) == 0.5, "negative exponent");
check(std.Math.pow(9)(0.5) == 3, "fractional exponent");
check(std.Math.pow(-2)(3) == -8, "odd exponent");
check(std.Number.isNaN(std.Math.pow(-2)(0.5)), "negative fractional power");
check(std.Math.pow(2)(-1074) == parse("5e-324"), "subnormal power");
check(std.Math.pow(nan)(0) == 1, "NaN to zero power");
check(std.Math.pow(-0)(-3) < 0 && !std.Number.isFinite(std.Math.pow(-0)(-3)), "zero negative power");
check(std.JSON.stringify(std.Math.pow(-0)(3)) == "-0", "zero odd power");
check(std.Math.floor(inf) == inf, "infinite floor");
check(std.Number.isNaN(std.Math.trunc(nan)), "NaN trunc");
check(std.JSON.stringify(std.Math.abs(-0)) == "0", "absolute zero");
check(std.JSON.stringify(std.Math.ceil(-0.1)) == "-0", "ceil signed zero");
check(std.JSON.stringify(std.Math.round(-0.1)) == "-0", "round signed zero");
check(std.Math.round(-2.5) == -3, "round ties away");
check(std.JSON.stringify(std.Math.sin(-0)) == "-0", "sin signed zero");
check(near(std.Math.sin(1), 0.8414709848078965), "sin one");
check(near(std.Math.cos(1), 0.5403023058681398), "cos one");
check(near(std.Math.sin(parse("1e300")), -0.8178819121159085), "huge sin");
check(near(std.Math.cos(parse("1e300")), -0.5753861119575491), "huge cos");
check(std.Number.isNaN(std.Math.sin(inf)), "infinite sin");
let unary = [std.Math.abs, std.Math.floor, std.Math.ceil, std.Math.round, std.Math.trunc, std.Math.sqrt, std.Math.sin, std.Math.cos];
i = 0; while i < unary.length { check(unary[i]("bad").type == "TypeCheck", "math type validation"); i = i + 1; };
check(std.Math.pow("bad").type == "TypeCheck", "pow base type");
check(std.Math.pow(2)(null).type == "TypeCheck", "pow exponent type");
let first = std.Math.random(); let different = false; let inRange = first >= 0 && first < 1;
i = 0;
while i < 64 {
  let value = std.Math.random();
  inRange = inRange && value >= 0 && value < 1;
  if value != first { different = true; };
  i = i + 1;
};
check(inRange && different, "random range and variation");
println("numeric checks: " + std.String.toString(checks));
