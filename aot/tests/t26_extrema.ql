// Shared contracts for variadic Math extrema and the interpreter's native bridge.
let checks = 0; let failures = 0;
let check = (ok, name) -> {
  checks = checks + 1;
  if !ok { failures = failures + 1; println("FAIL " + name); };
};
let max = std.Math.max; let min = std.Math.min;
let nan = std.Number.parseFloat("NaN"); let inf = std.Number.parseFloat("inf");
check(max() == -inf, "empty max");
check(min() == inf, "empty min");
check(max(42) == 42, "singleton max is a Number");
check(min(42) == 42, "singleton min is a Number");
check(max(1, 8, -2) == 8, "three arguments max");
check(min(1, 8, -2) == -2, "three arguments min");
check(max(1, 2, 3, 4, 5, 6, 7, 8, 9) == 9, "nine arguments max");
check(min(9, 8, 7, 6, 5, 4, 3, 2, 1) == 1, "nine arguments min");
check(max(-inf) == -inf, "negative infinity max");
check(min(inf) == inf, "positive infinity min");
check(max(-inf, inf, -inf) == inf, "mixed infinities max");
check(min(inf, -inf, inf) == -inf, "mixed infinities min");
check(std.Number.isNaN(max(nan)), "singleton NaN max");
check(std.Number.isNaN(min(nan)), "singleton NaN min");
check(std.Number.isNaN(max(nan, 1, 2)), "leading NaN max");
check(std.Number.isNaN(min(nan, 1, 2)), "leading NaN min");
check(std.Number.isNaN(max(1, nan, 2)), "middle NaN max");
check(std.Number.isNaN(min(1, nan, 2)), "middle NaN min");
check(std.Number.isNaN(max(1, 2, nan)), "trailing NaN max");
check(std.Number.isNaN(min(1, 2, nan)), "trailing NaN min");
check(std.JSON.stringify(max(-0)) == "-0", "singleton negative zero max");
check(std.JSON.stringify(min(-0)) == "-0", "singleton negative zero min");
check(std.JSON.stringify(max(-0, 0)) == "0", "mixed zero max");
check(std.JSON.stringify(max(0, -0)) == "0", "reversed zero max");
check(std.JSON.stringify(min(-0, 0)) == "-0", "mixed zero min");
check(std.JSON.stringify(min(0, -0)) == "-0", "reversed zero min");
check(std.JSON.stringify(max(-0, -0)) == "-0", "all negative zero max");
check(std.JSON.stringify(min(0, 0)) == "0", "all positive zero min");
check(max(null).type == "TypeMismatch", "null argument");
check(min(true).type == "TypeMismatch", "Boolean argument");
check(max([]).type == "TypeMismatch", "Array is not spread");
check(min({}).type == "TypeMismatch", "Object argument");
check(max(x -> x).type == "TypeMismatch", "Function argument");
check(min("1").type == "TypeMismatch", "String argument");
check(max(1, 2, 3, 4, 5, "bad").type == "TypeMismatch", "late invalid max");
check(min(1, 2, 3, 4, 5, "bad").type == "TypeMismatch", "late invalid min");
check(max(nan, "bad").type == "TypeMismatch", "NaN cannot hide invalid max argument");
check(min(nan, "bad").type == "TypeMismatch", "NaN cannot hide invalid min argument");
let first = Error.raise("first"); let second = Error.raise("second");
let err = max(1, 2, 3, 4, first, second);
check(err.type == "TypeMismatch" && err.cause.message == "first", "first Error cause max");
err = min("bad", nan, first);
check(err.type == "TypeMismatch" && err.cause.message == "first", "Error policy precedes numeric validation");
check(std.String.includes(err.message)("Math.min"), "native name in diagnostic");
let sequence = 0;
let value = (n) -> { sequence = sequence * 10 + n; n; };
let callee = () -> { sequence = sequence * 10 + 1; max; };
let result = callee()(value(2), value(3), value(4), value(5), value(6));
check(result == 6 && sequence == 123456, "callee and arguments evaluated once in order");
sequence = 0;
err = min("bad", value(1), value(2), value(3), value(4), value(5));
check(err.type == "TypeMismatch" && sequence == 12345, "arguments evaluated before type failure");
sequence = 0;
err = max(first, value(1), value(2), value(3), value(4), value(5));
check(err.cause.message == "first" && sequence == 12345, "arguments evaluated before Error rejection");
let functions = [max, min];
check(functions[0](1, 9, 2, 3, 4, 5) == 9, "computed callee");
let choose = (f) -> f(8, 2, 3, 4, 5, 6);
check(choose(min) == 2, "higher order call");
let withArgs = (f, a, b, c, d, e) -> f(a, b, c, d, e);
let partial = withArgs(max, 1, 2);
check(partial(3, 4, 5) == 5, "partial around variadic native");
let imported = import ./modules/extrema.ql;
check(imported.maximum(1, 2, 3, 4, 5, 6) == 6, "imported max alias");
check(imported.minimum(6, 5, 4, 3, 2, 1) == 1, "imported min alias");
std.Math.max = (a, b, c, d, e, f) -> a + b + c + d + e + f;
check(std.Math.max(1, 2, 3, 4, 5, 6) == 21, "user replacement uses ordinary function dispatch");
check(max(1, 2, 3, 4, 5, 6) == 6, "saved alias survives namespace mutation");
println("extrema checks: " + std.String.toString(checks));
