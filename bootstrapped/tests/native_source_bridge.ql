import ../lexer.ql;
import ../parser.ql;
import ../interpreter.ql;
let checks = 0; let zero = 0;
let check = (ok, label) -> { checks = checks + 1; if !ok { println("FAIL " + label); }; };
let parse = (text, path) -> { let p = Parser(Lexer(text).tokenize()); p.setSource(text); p.setSourcePath(path); p.parse(); };
let diagnostics = std.__diagnostics;
let core = Interpreter();
let native = (x) -> 1 / zero;
core.globalEnv._define("native", native);
let outer = diagnostics.enter({file: "host-scope.ql", line: 80, col: 2});
let result = core.runProgram(parse("native(1);", "user.ql"));
let after = 1 / zero;
diagnostics.leave(outer);
let error = result.value.value;
check(error.line == 9 && error.col == 21, "native function origin");
check(error.trace.type == "UndefinedField", "no public native trace");
check(after.line == 80 && after.col == 2, "outer scope restored");
let full = (x, y) -> 1 / zero;
core.globalEnv._define("partial", full(1));
let partialResult = core.runProgram(parse("partial(2);", "partial-user.ql"));
let partialError = partialResult.value.value;
check(partialError.line == 19 && partialError.col == 22, "native partial origin");
check(partialError.trace.type == "UndefinedField", "no public partial trace");
let callbackCore = Interpreter(); callbackCore.globalEnv._define("zero", 0);
let callbackProgram = parse("1 / zero;", "callback.ql");
let reenter = (x) -> { let r = callbackCore.runProgram(callbackProgram); r.value.value; };
core.globalEnv._define("reenter", reenter);
let reentered = core.runProgram(parse("reenter(1);", "outer-user.ql"));
let callbackError = reentered.value.value;
check(callbackError.line == 1 && callbackError.col == 1, "callback keeps interpreted origin");
check(callbackError.trace.type == "UndefinedField", "no public callback trace");
let noLeak = 1 / zero;
check(noLeak.line == 33 && noLeak.col == 14, "context does not escape interpreter");
println("native source bridge checks: " + std.String.toString(checks));
if args.length > 0 && args[0] == "native" { error?; };
if args.length > 0 && args[0] == "partial" { partialError?; };
if args.length > 0 && args[0] == "callback" { callbackError?; };
if args.length > 0 && args[0] == "after" { after?; };
if args.length > 0 && args[0] == "no-leak" { noLeak?; };
